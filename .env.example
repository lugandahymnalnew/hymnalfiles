PORT=3300

# MongoDB
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# MySQL (legacy, currently unused by active routes)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# FTP (used for profile picture uploads)
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=

# SMTP (email verification + password reset)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ennyimba Za Kristo" <no-reply@example.com>
CONTACT_EMAIL=
APP_URL=http://localhost:3300

# Auth
SESSION_SECRET=change-me
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=7d
