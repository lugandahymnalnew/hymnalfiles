<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ebyokuyiga | Ennyimba Za Kristo</title>
    <style>
        :root {
            --bg: #f3efe7;
            --panel: #fffdf8;
            --ink: #1d2a2f;
            --muted: #607078;
            --accent: #0f766e;
            --accent-strong: #0b5b55;
            --gold: #b58538;
            --line: rgba(22, 40, 48, 0.12);
            --shadow: 0 18px 40px rgba(28, 40, 44, 0.12);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at top left, rgba(15, 118, 110, 0.14), transparent 28%),
                radial-gradient(circle at bottom right, rgba(181, 138, 69, 0.14), transparent 30%),
                linear-gradient(180deg, #f8f4ec 0%, #efe8dc 100%);
        }

        header.top-bar {
            display: flex;
            align-items: center;
            padding: 16px 20px;
            position: sticky;
            top: 0;
            background: rgba(248, 244, 236, 0.92);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--line);
            z-index: 10;
        }

        .top-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.92rem;
        }

        .top-link:hover {
            color: var(--accent);
        }

        .page-head {
            text-align: center;
            padding: 28px 20px 8px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(255, 253, 248, 0.72);
            border: 1px solid rgba(255,255,255,0.65);
            font-size: 12px;
            color: var(--muted);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .page-head h1 {
            margin: 14px 0 8px;
            font-size: clamp(1.8rem, 5vw, 2.6rem);
        }

        .page-head p {
            margin: 0 auto;
            max-width: 480px;
            color: var(--muted);
            line-height: 1.6;
        }

        .grid {
            max-width: 1100px;
            margin: 28px auto 60px;
            padding: 0 20px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 20px;
        }

        .book-card {
            background: var(--panel);
            border: 1px solid rgba(255,255,255,0.85);
            border-radius: 20px;
            box-shadow: var(--shadow);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .book-image-wrap {
            aspect-ratio: 4 / 3;
            background: rgba(15, 118, 110, 0.06);
            overflow: hidden;
        }

        .book-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .book-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .book-title {
            margin: 0 0 6px;
            font-size: 1.1rem;
            font-weight: 700;
        }

        .book-author {
            margin: 0 0 16px;
            color: var(--muted);
            font-size: 0.88rem;
        }

        .read-btn {
            margin-top: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: none;
            border-radius: 14px;
            padding: 12px 16px;
            background: linear-gradient(135deg, var(--accent), var(--accent-strong));
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 12px 22px rgba(15, 118, 110, 0.2);
        }

        .empty-state {
            max-width: 480px;
            margin: 40px auto;
            padding: 32px 24px;
            text-align: center;
            background: var(--panel);
            border: 1px solid rgba(255,255,255,0.85);
            border-radius: 20px;
            box-shadow: var(--shadow);
            color: var(--muted);
        }

        @media (max-width: 480px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <header class="top-bar">
        <a class="top-link" href="/index.html">&#8249; Back to home</a>
    </header>

    <div class="page-head">
        <div class="eyebrow">Ebyokuyiga</div>
        <h1>Lessons &amp; Reading</h1>
        <p>Study materials and books to support your worship and learning.</p>
    </div>

    <% if (!books || books.length === 0) { %>
        <div class="empty-state">
            No lessons have been published yet. Check back soon.
        </div>
    <% } else { %>
        <div class="grid">
            <% books.forEach(book => { %>
                <div class="book-card">
                    <div class="book-image-wrap">
                        <img class="book-image" src="data:image/jpeg;base64,<%= book.base64Image %>" alt="<%= book.bookName %>">
                    </div>
                    <div class="book-body">
                        <h2 class="book-title"><%= book.bookName %></h2>
                        <p class="book-author">Author: <%= book.author %></p>
                        <button class="read-btn" onclick='openUrl1("<%= book.link %>")'>Read book &middot; Soma</button>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <script>
        function openUrl1(url){
            try {
                B4A.CallSub('Open_web', true ,url)
            } catch (error) {
                window.open(url, "_blank");
            }
        }
    </script>
</body>
</html>
