<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | Ennyimba Za Kristo</title>
    <style>
        :root {
            --bg: #f3efe7;
            --panel: #fffdf8;
            --ink: #1d2a2f;
            --muted: #607078;
            --accent: #0f766e;
            --accent-strong: #0b5b55;
            --line: rgba(22, 40, 48, 0.12);
            --warn-bg: #fff6d9;
            --warn-ink: #785b00;
            --danger-bg: #fce9e8;
            --danger-ink: #8b2822;
            --shadow: 0 24px 60px rgba(28, 40, 44, 0.14);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at top left, rgba(15, 118, 110, 0.18), transparent 28%),
                radial-gradient(circle at bottom right, rgba(181, 138, 69, 0.18), transparent 30%),
                linear-gradient(180deg, #f8f4ec 0%, #efe8dc 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .auth-card {
            width: 100%;
            max-width: 420px;
            padding: 34px;
            border-radius: 28px;
            background: rgba(255, 253, 248, 0.9);
            border: 1px solid rgba(255,255,255,0.85);
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
        }
        .top-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.92rem;
            margin-bottom: 20px;
        }
        .auth-card h2 { margin: 0; font-size: 1.8rem; }
        .auth-card p.lead { margin: 10px 0 0; color: var(--muted); line-height: 1.6; }
        .message {
            margin-top: 18px;
            padding: 13px 14px;
            border-radius: 14px;
            font-size: 0.94rem;
            line-height: 1.5;
        }
        .message.info { background: var(--warn-bg); color: var(--warn-ink); }
        .message.error { background: var(--danger-bg); color: var(--danger-ink); }
        .message.success { background: #e3f4ee; color: var(--accent-strong); }
        form { margin-top: 22px; }
        .field { margin-bottom: 16px; }
        .field label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.95rem; }
        .field input {
            width: 100%;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--ink);
            border-radius: 16px;
            padding: 14px 16px;
            font-size: 1rem;
        }
        .field input:focus {
            outline: none;
            border-color: rgba(15, 118, 110, 0.55);
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.12);
        }
        .submit {
            width: 100%;
            border: none;
            border-radius: 16px;
            padding: 15px 18px;
            background: linear-gradient(135deg, var(--accent), var(--accent-strong));
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 16px 28px rgba(15, 118, 110, 0.22);
        }
        .submit:disabled { opacity: 0.6; cursor: not-allowed; }
        .switch { margin-top: 18px; color: var(--muted); font-size: 0.94rem; text-align: center; }
        .switch a { color: var(--accent); font-weight: 700; text-decoration: none; }
    </style>
</head>
<body>
    <div class="auth-card">
        <a class="top-link" href="/login">&#8249; Back to login</a>
        <h2>Forgot your password?</h2>
        <p class="lead">Enter the email you registered with and we'll send you a link to reset your password.</p>

        <div class="message" id="formMessage" style="display:none;"></div>

        <form id="forgotForm">
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email">
            </div>
            <button class="submit" id="submitBtn" type="submit">Send reset link</button>
        </form>

        <div class="switch">Remembered it? <a href="/login">Sign in</a></div>
    </div>

    <script>
        document.getElementById('forgotForm').addEventListener('submit', function (event) {
            event.preventDefault();

            var message = document.getElementById('formMessage');
            var submitBtn = document.getElementById('submitBtn');
            message.style.display = 'none';
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending...';

            fetch('/api/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: document.getElementById('email').value })
            })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                message.className = 'message ' + (data.success ? 'success' : 'error');
                message.textContent = data.message || (data.success ? 'Check your email for a reset link.' : 'Something went wrong.');
                message.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send reset link';
            })
            .catch(function () {
                message.className = 'message error';
                message.textContent = 'Could not reach the server. Please try again.';
                message.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send reset link';
            });
        });
    </script>
</body>
</html>
