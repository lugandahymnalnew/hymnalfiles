<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Feedback | Ennyimba Za Kristo</title>
    <style>
        :root {
            --bg: #f3efe7;
            --panel: #fffdf8;
            --ink: #1d2a2f;
            --muted: #607078;
            --accent: #0f766e;
            --accent-strong: #0b5b55;
            --line: rgba(22, 40, 48, 0.12);
            --gold: #b58538;
            --shadow: 0 24px 60px rgba(28, 40, 44, 0.14);
            --success-bg: rgba(15, 118, 110, 0.12);
            --success-ink: #0f766e;
            --danger-bg: rgba(196, 62, 62, 0.12);
            --danger-ink: #b23e3e;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ink);
            background: linear-gradient(180deg, #f8f4ec 0%, #efe8dc 100%);
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            margin-bottom: 24px;
            padding: 20px 0;
            border-bottom: 1px solid var(--line);
        }

        .header h1 { margin: 0; font-size: 1.8rem; }

        .card {
            background: var(--panel);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 1.2rem;
            margin: 32px 0 16px;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--line);
        }

        .feedback-item {
            padding: 16px;
            border: 1px solid var(--line);
            border-radius: 12px;
            margin-bottom: 12px;
        }

        .feedback-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 8px;
        }

        .feedback-title {
            font-weight: 600;
            font-size: 1rem;
            margin: 0;
        }

        .feedback-meta {
            font-size: 0.85rem;
            color: var(--muted);
        }

        .badge {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-hymn {
            background: rgba(15, 118, 110, 0.12);
            color: var(--accent);
        }

        .badge-general {
            background: rgba(181, 133, 56, 0.12);
            color: var(--gold);
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-open { background: var(--success-bg); color: var(--success-ink); }
        .status-resolved { background: var(--danger-bg); color: var(--danger-ink); }

        .btn {
            padding: 10px 20px;
            border-radius: 10px;
            border: none;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-strong));
            color: white;
        }

        .btn-secondary {
            background: var(--panel);
            color: var(--ink);
            border: 1px solid var(--line);
        }

        .back-link {
            color: var(--muted);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .back-link:hover { color: var(--accent); }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--muted);
        }

        a { color: var(--accent); text-decoration: none; }
        a:hover { text-decoration: underline; }

        @media (max-width: 640px) {
            .container { padding: 12px; }
            .header { margin-bottom: 14px; padding: 10px 0; }
            .header h1 { font-size: 1.25rem; }
            .card {
                padding: 14px;
                border-radius: 12px;
                box-shadow: 0 2px 10px rgba(28, 40, 44, 0.1);
            }
            .section-title { margin: 20px 0 10px; font-size: 1.05rem; }
            .feedback-item { padding: 12px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/feedback" class="back-link">← Back to Forum</a>

        <div class="header">
            <h1>My Feedback</h1>
            <p style="color: var(--muted); margin: 8px 0 0;">Track your submitted feedback and issues</p>
        </div>

        <!--
            This page is filled in by the browser, not by the server. The
            session lives in localStorage, so the server cannot tell who is
            asking when the page is first requested — it used to send every
            visitor to the login page, which sent them back here. The data
            comes from /api/feedback/my-feedback, which is behind the same
            auth check as before.
        -->
        <div id="myFeedbackStatus" class="empty-state">Loading your feedback…</div>

        <h2 class="section-title">Hymn Issues</h2>
        <div id="hymnIssues"></div>

        <h2 class="section-title">General Feedback</h2>
        <div id="generalFeedback"></div>
    </div>

    <script src="/js/auth.js"></script>
    <script src="/js/forum-account.js"></script>
    <script>
        (function () {
            var statusBox = document.getElementById('myFeedbackStatus');
            var hymnBox = document.getElementById('hymnIssues');
            var generalBox = document.getElementById('generalFeedback');

            function statusClass(status) {
                return status === 'resolved' ? 'status-resolved' : 'status-open';
            }

            function formatDate(value) {
                if (!value) return '';
                var date = new Date(value);
                if (isNaN(date.getTime())) return '';
                return date.toLocaleDateString();
            }

            function addText(parent, text) {
                parent.appendChild(document.createTextNode(text));
            }

            function badge(parent, text, className) {
                var span = document.createElement('span');
                span.className = className;
                span.textContent = text;
                parent.appendChild(span);
            }

            function statusBadge(parent, status) {
                var span = document.createElement('span');
                span.className = 'status-badge ' + statusClass(status);
                span.textContent = status || '';
                parent.appendChild(span);
            }

            function clear(node) {
                while (node.firstChild) {
                    node.removeChild(node.firstChild);
                }
            }

            function emptyState(parent, message, linkText, linkHref) {
                var box = document.createElement('div');
                box.className = 'empty-state';

                var para = document.createElement('p');
                para.textContent = message;
                box.appendChild(para);

                var link = document.createElement('a');
                link.href = linkHref;
                link.className = 'btn btn-primary';
                link.textContent = linkText;
                box.appendChild(link);

                parent.appendChild(box);
            }

            function metaLine(parent, badgeText, badgeClass, item) {
                var meta = document.createElement('div');
                meta.className = 'feedback-meta';

                badge(meta, badgeText, badgeClass);

                var category = item.category || '';
                var date = formatDate(item.createdAt);
                addText(meta, ' ' + (category && date ? category + ' • ' + date : (category || date)));

                if (item.upvotes && item.upvotes.length > 0) {
                    addText(meta, ' • ▲ ' + item.upvotes.length + ' upvotes');
                }
                if (item.replyCount && item.replyCount > 0) {
                    addText(meta, ' • 💬 ' + item.replyCount + ' replies');
                }

                parent.appendChild(meta);
            }

            function hymnIssueItem(issue) {
                var item = document.createElement('div');
                item.className = 'feedback-item';

                var head = document.createElement('div');
                head.className = 'feedback-header';

                var title = document.createElement('h4');
                title.className = 'feedback-title';
                title.textContent = issue.title || '';
                head.appendChild(title);

                statusBadge(head, issue.status);

                item.appendChild(head);
                metaLine(item, 'Hymn Issue', 'badge badge-hymn', issue);

                return item;
            }

            function generalItem(fb) {
                var item = document.createElement('div');
                item.className = 'feedback-item';

                var head = document.createElement('div');
                head.className = 'feedback-header';

                var title = document.createElement('h4');
                title.className = 'feedback-title';

                var link = document.createElement('a');
                link.href = '/feedback/general/' + encodeURIComponent(fb._id);
                link.textContent = fb.title || '';
                title.appendChild(link);
                head.appendChild(title);

                statusBadge(head, fb.status);

                item.appendChild(head);
                metaLine(item, 'General', 'badge badge-general', fb);

                return item;
            }

            function render(data) {
                statusBox.style.display = 'none';

                var hymnIssues = (data && data.hymnIssues) || [];
                var generalFeedback = (data && data.generalFeedback) || [];

                if (hymnIssues.length === 0) {
                    emptyState(hymnBox,
                        "You haven't reported any hymn issues yet.",
                        'Report an Issue', '/feedback/create?type=hymn');
                } else {
                    hymnIssues.forEach(function (hymn) {
                        var card = document.createElement('div');
                        card.className = 'card';

                        var heading = document.createElement('h3');
                        heading.style.marginTop = '0';
                        heading.textContent = 'Hymn ' + hymn.hymnNumber;
                        card.appendChild(heading);

                        (hymn.issues || []).forEach(function (issue) {
                            card.appendChild(hymnIssueItem(issue));
                        });

                        var link = document.createElement('a');
                        link.href = '/feedback/hymn/' + encodeURIComponent(hymn.hymnNumber);
                        link.className = 'btn btn-secondary';
                        link.style.marginTop = '12px';
                        link.textContent = 'View Thread';
                        card.appendChild(link);

                        hymnBox.appendChild(card);
                    });
                }

                if (generalFeedback.length === 0) {
                    emptyState(generalBox,
                        "You haven't submitted any general feedback yet.",
                        'Create Feedback', '/feedback/create?type=general');
                } else {
                    generalFeedback.forEach(function (fb) {
                        generalBox.appendChild(generalItem(fb));
                    });
                }
            }

            function signedOut() {
                statusBox.style.display = '';
                statusBox.textContent = '';
                statusBox.appendChild(document.createTextNode('Sign in to see your feedback. '));

                var link = document.createElement('a');
                link.href = '/login?returnTo=' + encodeURIComponent('/feedback/my-feedback');
                link.textContent = 'Sign in';
                statusBox.appendChild(link);

                clear(hymnBox);
                clear(generalBox);
            }

            if (!window.auth) {
                signedOut();
                return;
            }

            window.auth.apiRequest('/api/feedback/my-feedback').then(function (response) {
                if (response.status === 401 || response.status === 403) {
                    signedOut();
                    return;
                }
                if (!response.ok) {
                    statusBox.textContent = 'Your feedback could not be loaded. Please try again in a moment.';
                    return;
                }
                return response.json().then(function (body) {
                    if (body && body.success) {
                        render(body.data);
                    } else {
                        statusBox.textContent = 'Your feedback could not be loaded. Please try again in a moment.';
                    }
                });
            }).catch(function () {
                statusBox.textContent = 'Your feedback could not be loaded. Please try again in a moment.';
            });
        })();
    </script>
</body>
</html>
