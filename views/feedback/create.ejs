<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Feedback | Ennyimba Za Kristo</title>
    <style>
        :root {
            --bg: #f3efe7;
            --panel: #fffdf8;
            --ink: #1d2a2f;
            --muted: #607078;
            --accent: #0f766e;
            --accent-strong: #0b5b55;
            --line: rgba(22, 40, 48, 0.12);
            --shadow: 0 24px 60px rgba(28, 40, 44, 0.14);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ink);
            background: linear-gradient(180deg, #f8f4ec 0%, #efe8dc 100%);
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }

        .card {
            background: var(--panel);
            border-radius: 20px;
            padding: 32px;
            box-shadow: var(--shadow);
        }

        h1 {
            margin: 0 0 8px;
            font-size: 1.8rem;
        }

        .subtitle {
            color: var(--muted);
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 14px;
            border: 1px solid var(--line);
            border-radius: 12px;
            font-size: 1rem;
            font-family: inherit;
        }

        .form-group textarea {
            min-height: 150px;
            resize: vertical;
        }

        .form-group small {
            display: block;
            margin-top: 6px;
            color: var(--muted);
            font-size: 0.85rem;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 12px;
            border: none;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-strong));
            color: white;
        }

        .btn-secondary {
            background: var(--panel);
            color: var(--ink);
            border: 1px solid var(--line);
            margin-left: 12px;
        }

        .back-link {
            color: var(--muted);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .back-link:hover { color: var(--accent); }

        .alert {
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #fce9e8;
            color: #8b2822;
        }

        .alert-info {
            background: rgba(15, 118, 110, 0.1);
            color: var(--accent-strong);
        }

        .alert-info a {
            color: inherit;
            font-weight: 700;
        }

        .hidden { display: none; }

        @media (max-width: 640px) {
            .container { padding: 12px; }
            .card {
                padding: 18px 16px;
                border-radius: 14px;
                box-shadow: 0 2px 10px rgba(28, 40, 44, 0.1);
            }
            h1 { font-size: 1.4rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/feedback" class="back-link">← Back to Forum</a>

        <div class="card">
            <h1 id="formTitle">Create Feedback</h1>
            <p class="subtitle" id="formSubtitle">Share your thoughts with the community</p>

            <div class="alert alert-info hidden" id="anonNotice">
                You're not signed in, so this will be posted as <b>Anonymous</b>.
                <a href="#" id="anonSignInLink">Sign in</a> to have your name shown instead.
            </div>

            <div class="alert alert-error hidden" id="errorAlert"></div>

            <form id="feedbackForm" onsubmit="submitFeedback(event)">
                <!-- Hymn Number Field (for hymn feedback) -->
                <div class="form-group hidden" id="hymnNumberGroup">
                    <label for="hymnNumber">Hymn Number</label>
                    <input type="text" id="hymnNumber" placeholder="e.g., 13" value="<%= hymnNumber %>">
                    <small>Enter the hymn number you want to report an issue for</small>
                </div>

                <!-- Title Field -->
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" required placeholder="Brief summary of your feedback">
                </div>

                <!-- Category Field -->
                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category">
                        <option value="error">Error/Mistake</option>
                        <option value="suggestion">Suggestion</option>
                        <option value="correction">Correction Needed</option>
                        <option value="general">General Discussion</option>
                        <option value="feature">Feature Request</option>
                    </select>
                </div>

                <!-- Priority Field (general feedback only) -->
                <div class="form-group hidden" id="priorityGroup">
                    <label for="priority">Priority</label>
                    <select id="priority">
                        <option value="low">Low</option>
                        <option value="medium" selected>Medium</option>
                        <option value="high">High</option>
                    </select>
                </div>

                <!-- Description Field -->
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" required placeholder="Describe your feedback in detail..."></textarea>
                    <small>Please provide as much detail as possible to help us understand your feedback.</small>
                </div>

                <div style="margin-top: 24px;">
                    <button type="submit" class="btn btn-primary" id="submitBtn">Submit Feedback</button>
                    <a href="/feedback" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/auth.js"></script>
    <script>
        const feedbackType = '<%= type %>';
        const isHymnFeedback = feedbackType === 'hymn';

        // Set up form based on type
        if (isHymnFeedback) {
            document.getElementById('formTitle').textContent = 'Report Hymn Issue';
            document.getElementById('formSubtitle').textContent = 'Report an error or suggest improvements for a specific hymn';
            document.getElementById('hymnNumberGroup').classList.remove('hidden');
            document.getElementById('hymnNumber').required = true;
            document.getElementById('priorityGroup').classList.add('hidden');

            // Update category options for hymn feedback
            const categorySelect = document.getElementById('category');
            categorySelect.innerHTML = `
                <option value="error">Error/Mistake</option>
                <option value="suggestion">Suggestion</option>
                <option value="correction">Correction Needed</option>
            `;
        } else {
            document.getElementById('formTitle').textContent = 'General Feedback';
            document.getElementById('formSubtitle').textContent = 'Share your thoughts, suggestions, or report issues';
            document.getElementById('hymnNumberGroup').classList.add('hidden');
            document.getElementById('priorityGroup').classList.remove('hidden');
        }

        // Anyone can submit; a signed-out visitor just gets told they'll show
        // up as Anonymous, instead of being turned away.
        if (!auth.isLoggedIn()) {
            const notice = document.getElementById('anonNotice');
            notice.classList.remove('hidden');
            document.getElementById('anonSignInLink').href =
                '/login?redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
        }

        async function submitFeedback(event) {
            event.preventDefault();

            const title = document.getElementById('title').value;
            const category = document.getElementById('category').value;
            const description = document.getElementById('description').value;

            let url, body;

            if (isHymnFeedback) {
                const hymnNumber = document.getElementById('hymnNumber').value;

                if (!hymnNumber) {
                    showError('Please enter a hymn number');
                    return;
                }

                url = '/api/feedback/hymn/' + hymnNumber + '/issue';
                body = { title, category, description };
            } else {
                const priority = document.getElementById('priority').value;

                url = '/api/feedback/general/new';
                body = { title, category, message: description, priority };
            }

            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').textContent = 'Submitting...';

            try {
                const response = await auth.apiRequest(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    if (isHymnFeedback) {
                        window.location.href = '/feedback/hymn/' + document.getElementById('hymnNumber').value;
                    } else {
                        window.location.href = '/feedback';
                    }
                } else {
                    showError(data.message || 'Failed to submit feedback');
                    document.getElementById('submitBtn').disabled = false;
                    document.getElementById('submitBtn').textContent = 'Submit Feedback';
                }
            } catch (error) {
                showError('Error: ' + error.message);
                document.getElementById('submitBtn').disabled = false;
                document.getElementById('submitBtn').textContent = 'Submit Feedback';
            }
        }

        function showError(message) {
            const alert = document.getElementById('errorAlert');
            alert.textContent = message;
            alert.classList.remove('hidden');
        }
    </script>
</body>
</html>
